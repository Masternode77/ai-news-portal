---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
import {
  adsConfigured,
  adsEnabled,
  analyticsConfigured,
  analyticsEnabled,
  googleCmpReady,
} from '../lib/monetization';

const effectiveDate = 'August 9, 2026';
const advertisingStatus = adsEnabled
  ? 'Advertising is active only on eligible public content pages. This privacy page does not load advertising, analytics, or consent-management tags.'
  : adsConfigured
    ? 'A Google AdSense publisher ID is configured for ownership verification and ads.txt, but advertising is not active until the operator has completed and tested the certified Google CMP handoff.'
    : 'Google advertising is not configured for this deployment.';
const analyticsStatus = analyticsEnabled
  ? 'Google Analytics 4 is active only on eligible public content pages to measure aggregated readership.'
  : analyticsConfigured
    ? 'A Google Analytics 4 measurement ID is configured, but Analytics is not active until the operator has completed and tested the certified Google CMP handoff.'
    : 'Google Analytics 4 is not configured for this deployment.';
const cmpStatus = googleCmpReady
  ? 'The operator has marked the certified Google CMP handoff as ready. That setting is reviewed separately from this privacy notice.'
  : 'The certified Google CMP handoff is not marked ready, so consent-requiring Google advertising and analytics tags remain disabled.';
---
<Layout
  title={`Privacy Policy | ${SITE.name}`}
  description="How Compute Current handles data: server logs, cookies, consent choices, analytics, and advertising services."
  canonicalPath="/privacy/"
>
  <main class="policy-shell">
    <a class="back-link" href="/">Latest analysis</a>
    <article class="policy-page">
      <p class="eyebrow">Privacy Policy</p>
      <h1>Your data, kept boring on purpose.</h1>
      <p class="policy-lede">
        Compute Current is a publicly readable publication. This notice describes the data practices that may apply
        when the operator enables measurement or advertising on eligible content pages. Effective date: {effectiveDate}.
      </p>

      <section>
        <h2>Who operates this site</h2>
        <p>
          Compute Current publishes AI infrastructure coverage at {SITE.url}. For any privacy question or request,
          email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
        </p>
      </section>

      <section>
        <h2>What we collect automatically</h2>
        <p>
          Our hosting provider may process standard server logs, such as IP address, user agent, requested URL, and
          timestamp, to serve pages, protect the service from abuse, and diagnose failures. The operator sets and
          reviews applicable retention periods with the hosting provider and professional advisers.
        </p>
      </section>

      <section>
        <h2>Analytics</h2>
        <p>
          {analyticsStatus} When active, Analytics is used to understand aggregate readership, including pages read,
          approximate referral sources, and traffic patterns. Its use and the applicable notice depend on the
          certified CMP configuration and the visitor&rsquo;s location.
        </p>
      </section>

      <section>
        <h2>Advertising</h2>
        <p>
          {advertisingStatus} When advertising is active, Google and its partners may use cookies, IP addresses, or
          other identifiers to serve and measure ads, including personalized advertising where applicable. You can
          control ad personalization in your Google account at{' '}
          <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer">adssettings.google.com</a>,
          and read how Google uses data from partner sites at{' '}
          <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">policies.google.com/technologies/partner-sites</a>.
        </p>
      </section>

      <section>
        <h2>Cookies and your choices</h2>
        <p>
          Where a certified Google consent message is active, it records choices and supports the applicable Google
          consent flow. Visitors in the EU/EEA, UK, or Switzerland can revisit a recorded choice by using the{' '}
          <strong>Privacy choices</strong> control in the footer of another public content page. This privacy page
          intentionally does not load the Google consent runtime. If that control is unavailable, the consent message
          may not apply to the visitor&rsquo;s location or may not be active; Google account controls remain available at
          the link above.
        </p>
        <p>{cmpStatus}</p>
      </section>

      <section>
        <h2>Legal bases</h2>
        <p>
          Legal bases, consent wording, vendor disclosures, and retention periods require operator and legal review
          for the jurisdictions in which the site is offered. This notice does not determine the legal basis for a
          particular visitor or location.
        </p>
      </section>

      <section>
        <h2>Your rights</h2>
        <p>
          Depending on your jurisdiction, you may have rights concerning personal data. To submit a privacy request,
          email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>. The operator will assess requests
          under the applicable law and the services involved.
        </p>
      </section>

      <section>
        <h2>Children</h2>
        <p>
          This site is professional infrastructure coverage and is not directed to children under 13. We do not
          knowingly collect personal information from children.
        </p>
      </section>

      <section>
        <h2>Changes</h2>
        <p>
          If this policy changes materially, the effective date above is updated and the new version is published
          at this address.
        </p>
      </section>

      <nav class="policy-link-row" aria-label="Related pages">
        <a href="/terms/">Terms of Use</a>
        <a href="/editorial-policy/">Editorial policy</a>
        <a href="/ai-disclosure/">AI-assisted Disclosure</a>
        <a href="/contact/">Contact</a>
      </nav>
    </article>
  </main>
</Layout>
