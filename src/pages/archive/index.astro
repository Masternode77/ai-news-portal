---
import Layout from '../../layouts/Layout.astro';
import PublicationExplorer from '../../components/PublicationExplorer.astro';
import latestNews from '../../data/latest-news.json';
import archivedNews from '../../data/archived-news.json';
import authoredColumns from '../../data/authored-columns.json';
import editorialCycles from '../../data/editorial-cycles.json';
import pipelineHeartbeat from '../../data/pipeline-heartbeat.json';
import { SITE } from '../../config/site';
import { buildPublicPublicationCatalog } from '../../../scripts/lib/public-publication-catalog.mjs';
import { buildFreshnessPublicModel } from '../../../scripts/lib/freshness-public-model.mjs';

const catalog = buildPublicPublicationCatalog({ articles: [...latestNews, ...archivedNews], columns: authoredColumns });
const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const sourceRecordDate = (article: { analysisPublishedAt?: string; publishedAt?: string; updatedAt?: string }) =>
  new Date(String(article.analysisPublishedAt || article.publishedAt || article.updatedAt || 0)).getTime();
const latestSourceRecordMs = [...latestNews, ...archivedNews].reduce((latest, article) => {
  const stamp = sourceRecordDate(article);
  return Number.isFinite(stamp) ? Math.max(latest, stamp) : latest;
}, 0);
const freshness = buildFreshnessPublicModel({
  cycles: editorialCycles,
  rssItems: [...latestNews, ...archivedNews],
  heartbeat: pipelineHeartbeat,
});
const lastSourceRecord = latestSourceRecordMs
  ? dateFormatter.format(new Date(latestSourceRecordMs))
  : 'not recorded';
const lastSuccessfulUpdate = freshness.last_successful_pipeline_at
  ? dateFormatter.format(new Date(freshness.last_successful_pipeline_at))
  : 'not recorded';
const sourceRecordStatus = `Source-linked records current through ${lastSourceRecord}`;
const currentLongFormStampMs = catalog
  .filter((item) => item.type === 'Analysis' || item.type === 'Column')
  .reduce((max, article) => {
    const stamp = new Date(String(article.date || 0)).getTime();
    return Number.isFinite(stamp) ? Math.max(max, stamp) : max;
  }, 0);
const freshestLongFormMs = Math.max(currentLongFormStampMs, new Date(freshness.latest_published_analysis_at || 0).getTime() || 0);
const latestAuthorizedLongFormAt = freshestLongFormMs
  ? new Date(freshestLongFormMs).toISOString()
  : '';
const longFormStatus = latestAuthorizedLongFormAt
  ? `Long-form publishing last authorized ${dateFormatter.format(new Date(latestAuthorizedLongFormAt))}`
  : 'Long-form publishing paused (0 authorized)';
const pipelineStatus = freshness.state === 'failed_pipeline'
  ? `Pipeline update failed; last successful update ${lastSuccessfulUpdate}`
  : freshness.state === 'stale_pipeline'
    ? `Pipeline update overdue since ${lastSuccessfulUpdate}`
    : `Pipeline last successful update ${lastSuccessfulUpdate}`;
---
<Layout title={`Publication archive | ${SITE.name}`} description="Browse the Compute Current publication archive." canonicalPath="/archive/">
  <main class="policy-shell taxonomy-page publication-archive">
    <a class="back-link" href="/">Read the latest</a>
    <section class="policy-page">
      <p class="eyebrow">Publication archive</p>
      <h1>Publication archive</h1>
      <p class="policy-lede">Browse recent AI infrastructure intelligence, briefs, and source-linked analysis. {sourceRecordStatus}. {longFormStatus}. {pipelineStatus}.</p>
    </section>
    <PublicationExplorer
      catalog={catalog}
      pageSize={18}
      heading="Search the publication archive"
      description="Find public analysis, columns, briefs, and signals by topic, type, source, or publication date."
    />
  </main>
</Layout>
