---
import Layout from '../../layouts/Layout.astro';
import LatestAnalysisFeed from '../../components/LatestAnalysisFeed.astro';
import taxonomyPages from '../../data/taxonomy-pages.json';
import { SITE } from '../../config/site';
import { buildHomepageFeed } from '../../../scripts/lib/homepage-feed-builder.mjs';
import IndustryRadar from '../../components/IndustryRadar.astro';
import industryHeadlines from '../../data/industry-headlines.json';
import { headlinesFor } from '../../../scripts/lib/industry-headlines-view.mjs';

export function getStaticPaths() {
  return (taxonomyPages.companies || []).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const feed = buildHomepageFeed(page.items || [], { limit: 50, minimumVisible: 0 });
const companyHeadlines = headlinesFor(industryHeadlines, { language: 'en', limit: 10, company: page.name });
---
<Layout title={`${page.name} | ${SITE.name}`} description={`Compute Current coverage involving ${page.name}.`} canonicalPath={`/company/${page.slug}/`}>
  <main class="policy-shell taxonomy-page">
    <a class="back-link" href="/">Latest analysis</a>
    <section class="policy-page">
      <p class="eyebrow">Company / Entity</p>
      <h1>{page.name}</h1>
      <p class="policy-lede">Public analysis and briefs involving this entity.</p>
    </section>
    <LatestAnalysisFeed feed={feed} title={page.name} dek="" />
    <IndustryRadar
      items={companyHeadlines}
      title={`${page.name} across the industry press`}
      eyebrow="Industry radar"
      dek={`Recent headlines naming ${page.name}, linked to each publisher.`}
      headingId="company-industry-radar"
      compact={true}
    />
  </main>
</Layout>
