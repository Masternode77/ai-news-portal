---
import { SITE } from '../config/site';

const year = 2026;
const coverage = [
  ['Power & Grid', '/category/power-grid/'],
  ['Data Centers', '/category/data-centers/'],
  ['Cloud Capacity', '/category/cloud-capacity/'],
  ['Semiconductors', '/category/semiconductors/'],
  ['Cooling', '/category/cooling/'],
  ['Capital Markets', '/category/capital-markets/'],
  ['Policy & Siting', '/category/regulation/'],
];
const publication = [
  ['The Current', '/column/'],
  ['About', '/about/'],
  ['Methodology', '/methodology/'],
  ['Editorial policy', '/editorial-policy/'],
  ['AI-assisted Disclosure', '/ai-disclosure/'],
  ['Contact', '/contact/'],
];
const reference = [
  ['Archive', '/archive/'],
  ['Follow / RSS', '/follow/'],
  ['Advertising policy', '/advertising-policy/'],
  ['Raw feed', '/rss.xml'],
  ['Sitemap', '/sitemap.xml'],
  ['Privacy policy', '/privacy/'],
  ['Terms of use', '/terms/'],
];
const showPrivacyChoices = Astro.url.pathname.replace(/\/$/, '') !== '/privacy';
---
<footer class="site-footer" aria-label="Site footer">
  <div class="site-footer-grid">
    <div class="site-footer-brand">
      <a class="site-footer-wordmark" href="/">
        <span>Compute</span><span>Current</span>
      </a>
      <p>
        Source-linked intelligence on the AI buildout: power, data centers, silicon, cloud capacity,
        cooling, policy, and capital. Coverage status follows the most recent successful update.
      </p>
      <a class="site-footer-rss" href="/follow/">
        <i aria-hidden="true"></i>
        Follow Compute Current
      </a>
    </div>
    <nav class="site-footer-col" aria-label="Coverage">
      <span class="site-footer-title">Coverage</span>
      {coverage.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <nav class="site-footer-col" aria-label="Publication">
      <span class="site-footer-title">Publication</span>
      {publication.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <nav class="site-footer-col" aria-label="Reference">
      <span class="site-footer-title">Reference</span>
      {reference.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
  <div class="site-footer-bar">
    <span>© {year} {SITE.name}. Every analysis links its original source.</span>
    <span class="site-footer-domain">{SITE.domain}</span>
  </div>
  {showPrivacyChoices ? (
    <>
      <button id="cc-privacy-choices" class="privacy-choices-control" type="button" hidden>
        Privacy choices
      </button>
      <script is:inline>
        (function () {
          var button = document.getElementById('cc-privacy-choices');
          if (!button) return;

          function showForGdprVisitors() {
            if (typeof window.__tcfapi !== 'function') return;
            window.__tcfapi('getTCData', 2, function (tcData, success) {
              if (success && tcData && tcData.gdprApplies === true) button.hidden = false;
            });
          }

          function showRevocationMessage() {
            var googleFc = window.googlefc;
            if (!googleFc || !googleFc.callbackQueue || typeof googleFc.callbackQueue.push !== 'function' || typeof googleFc.showRevocationMessage !== 'function') return;
            googleFc.callbackQueue.push(googleFc.showRevocationMessage);
          }

          window.googlefc = window.googlefc || {};
          window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
          window.googlefc.callbackQueue.push({ CONSENT_API_READY: showForGdprVisitors });
          button.addEventListener('click', showRevocationMessage);
        })();
      </script>
    </>
  ) : null}
</footer>
