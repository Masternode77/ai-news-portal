---
import OpenGraphImage from '../components/OpenGraphImage.astro';
import '../styles/global.css';
import '../styles/redesign.css';
import '../styles/public-intelligence.css';
import '../styles/terminal.css';
import { SITE } from '../config/site';
import {
  ADSENSE_CLIENT,
  GA4_ID,
  isAdsActiveForRoute,
  isAnalyticsActiveForRoute,
  isMonetizationActiveForRoute,
} from '../lib/monetization';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = SITE.name,
  description = SITE.description,
  image = SITE.defaultOgImage,
  canonicalPath,
  type = 'website',
  noindex = false,
} = Astro.props;

const joinUrl = (base: string, path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const canonical = canonicalPath ? joinUrl(SITE.url, canonicalPath) : joinUrl(SITE.url, Astro.url.pathname);

const adsActive = isAdsActiveForRoute(Astro.url.pathname);
const analyticsActive = isAnalyticsActiveForRoute(Astro.url.pathname);
const monetizationActive = isMonetizationActiveForRoute(Astro.url.pathname);

// The certified CMP, once configured, owns every consent update. Defaults are
// denied for every region; this site never stores or fabricates a local choice.
const consentModeBootstrap = [
  'window.dataLayer=window.dataLayer||[];',
  'function gtag(){dataLayer.push(arguments);}',
  "gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});",
  "gtag('set','ads_data_redaction',true);",
  analyticsActive ? `gtag('js',new Date());gtag('config','${GA4_ID}');` : '',
].join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={SITE.rssPath} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <OpenGraphImage image={image} alt={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {monetizationActive ? <script is:inline set:html={consentModeBootstrap}></script> : null}
    {analyticsActive ? (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      </>
    ) : null}
    {adsActive ? (
      <>
        <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
        <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        ></script>
      </>
    ) : null}
  </head>
  <body>
    <slot />
  </body>
</html>
