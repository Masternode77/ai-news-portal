# Compute Current environment template
# Leave values blank locally unless the feature is enabled. Never commit real secrets.

# Monetization (safe to leave blank: ads/analytics stay fully disabled)
# AdSense publisher ID, e.g. ca-pub-1234567890123456. Enables the AdSense
# loader, the google-adsense-account meta tag, and the live ads.txt entry.
PUBLIC_ADSENSE_CLIENT=
# Explicit operator attestation. Set to true only after a certified Google CMP message
# is published and tested for the applicable EEA/UK/Swiss traffic; otherwise leave false.
PUBLIC_GOOGLE_CMP_READY=false
# Explicit operator/editorial attestation. Set true only after a meaningful manually reviewed original article inventory
# includes at least one canonical public detail article with publication_integrity.ok=true. This flag cannot override
# a zero or invalid inventory because the runtime also enforces that nonzero verified-detail floor.
PUBLIC_ADSENSE_CONTENT_READY=false
# Optional per-placement ad unit ids (numbers from AdSense > Ads > By ad unit).
PUBLIC_ADSENSE_SLOT_LEADERBOARD=
PUBLIC_ADSENSE_SLOT_INFEED=
PUBLIC_ADSENSE_SLOT_ARTICLE=
PUBLIC_ADSENSE_SLOT_BOX=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (Consent Mode v2 built in).
PUBLIC_GA4_ID=

# Admin authentication
ADMIN_USERNAME=admin
# Replace this placeholder with output from scripts/admin-password-hash.mjs; malformed hashes and salts fail closed.
ADMIN_PASSWORD_HASH=scrypt$replace-with-salt$replace-with-derived-key
# Replace this placeholder with a cryptographically random 32+ byte secret; placeholders, common values, and low-entropy values fail closed.
ADMIN_SESSION_SECRET=replace-with-64-plus-random-characters
# Production fails closed while false. Set true only after the blocking Vercel Firewall IP rate-limit rule for POST /api/admin/login is published and tested.
ADMIN_VERCEL_RATE_LIMIT_READY=false

# Admin persistence
GITHUB_TOKEN=
GH_TOKEN=
COMPUTE_CURRENT_GITHUB_TOKEN=
GITHUB_REPO=Masternode77/ai-news-portal
GITHUB_BRANCH=main

# Content cycle and pipeline
PIPELINE_OFFLINE=0
PIPELINE_USE_EXISTING_POOL=0
CONTENT_CYCLE_FIXTURE=tests/fixtures/content-cycle-mixed.json
FORCE_GENERATION_FAILURE=0
REFRESH_INTERVAL_HOURS=8
MAX_ITEMS_FETCHED=30
MIN_ITEMS_PER_SOURCE_IN_POOL=1
DAILY_CURATION_TARGET=6
ITEMS_PER_RUN=2
FRESH_CANDIDATE_WINDOW_HOURS=24
LATEST_NEWS_LIMIT=30
PIPELINE_RETRY_DELAY_MS=15000

# Text generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Compute Current
EXPERT_LENS_MODEL=anthropic/claude-sonnet-4.5
EXPERT_LENS_FALLBACK_MODEL=openai/gpt-4o
# Per-run LLM spend ceilings (tokens / calls); the pipeline aborts further
# LLM work once either is reached.
LLM_RUN_BUDGET_TOKENS=60000
LLM_RUN_BUDGET_CALLS=40

# The Current (authored column)
AUTHORED_COLUMN_ENABLED=1
AUTHORED_COLUMN_MODEL=anthropic/claude-sonnet-4.5
AUTHORED_COLUMNS_PER_DAY=3
AUTHORED_COLUMN_MIN_GAP_HOURS=4
AUTHORED_COLUMN_FORCE=0
AUTHORED_MIN_CHARS=4500
AUTHORED_MAX_CHARS=16000
AUTHORED_MIN_WORDS=1000
AUTHORED_MAX_WORDS=2200
AUTHORED_MIN_HUMAN_STYLE=0.84
AUTHORED_MIN_INSIGHT_DENSITY=0.78

# Image generation
IMAGE_PROVIDER=image2
OPENAI_API_KEY=
OPENAI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
IMAGE2_HERO_SIZE=1536x864
IMAGE2_OUTPUT_FORMAT=webp
IMAGE2_PUBLIC_DIR=public
CHATGPT_IMAGE_OAUTH_ENDPOINT=
CHATGPT_IMAGE_OAUTH_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Archive persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ARCHIVE_TABLE=archived_articles

# Cache and deployment purge
COMPUTE_CURRENT_CACHE_PURGE_URL=
COMPUTE_CURRENT_CACHE_PURGE_TOKEN=
VERCEL_DEPLOY_HOOK_URL=
VERCEL_TOKEN=

# QA and preview controls
PUBLIC_OUTPUT_ARTICLE_LIMIT=50
PUBLIC_OUTPUT_MIN_LONGFORM_CHARS=4500
PUBLIC_SURFACE_ARTICLE_LIMIT=30
PUBLIC_SURFACE_BASE_URL=
PUBLIC_CONTENT_QUALITY_ARTICLE_LIMIT=50
PUBLIC_CONTENT_QUALITY_BASE_URL=
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=4173
PREVIEW_BASE_URL=
GITHUB_ACTIONS=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional source/network controls
SOURCE_HEALTH_SKIP_NETWORK=1
SOURCE_HEALTH_NETWORK=0
SOURCE_HEALTH_TIMEOUT_MS=4000
EMERGENCY_CLEANUP_ARCHIVE_LIMIT=100000
PUBLIC_CONTENT_REGEN_LIMIT=100
LONGFORM_TARGET=15
BRIEF_TARGET=35
NARRATIVE_DNA_REGENERATE_COUNT=100
EVAL_ARTICLE_LIMIT=10
ARTICLE_PAGE_QUALITY_THRESHOLD=0.8
WORKSPACE_ROOT=
