---
import Base from "../../layouts/Base.astro";
import PublicationList from "../../components/PublicationList.astro";
import Pager from "../../components/Pager.astro";
import { allPublications } from "../../lib/repo";
import { paginate } from "../../lib/listing";

const loaded = await allPublications();
if (loaded instanceof Response) {
  return loaded;
}
const { items, page, pages } = paginate(loaded, 1);
---

<Base title="Archive | Compute Current" description="Everything Compute Current has published, newest first." canonicalPath="/archive/" noindex={loaded.length === 0} current="/archive/">
  <header class="page-head">
    <div class="kicker">Archive</div>
    <h1>Latest</h1>
    <p>Briefs, analysis and columns, newest first.</p>
  </header>
  <div class="section">
    <PublicationList rows={items} />
    <Pager page={page} pages={pages} />
  </div>
</Base>
