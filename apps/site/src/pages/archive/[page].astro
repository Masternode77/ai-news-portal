---
import Base from "../../layouts/Base.astro";
import PublicationList from "../../components/PublicationList.astro";
import Pager from "../../components/Pager.astro";
import { allPublications } from "../../lib/repo";
import { archivePath, archiveRoute, paginate } from "../../lib/listing";

const loaded = await allPublications();
if (loaded instanceof Response) {
  return loaded;
}
const route = archiveRoute(Astro.params.page, loaded.length);
if (route.kind === "redirect") {
  return Astro.redirect(route.location, 301);
}
if (route.kind === "not_found") {
  return Astro.rewrite("/404");
}
const { items, page, pages } = paginate(loaded, route.page);
---

<Base title={`Archive, page ${page} | Compute Current`} description="Everything Compute Current has published, newest first." canonicalPath={archivePath(page)} current="/archive/">
  <header class="page-head">
    <div class="kicker">Archive</div>
    <h1>Latest · page {page}</h1>
    <p>Briefs, analysis and columns, newest first.</p>
  </header>
  <div class="section">
    <PublicationList rows={items} />
    <Pager page={page} pages={pages} />
  </div>
</Base>
