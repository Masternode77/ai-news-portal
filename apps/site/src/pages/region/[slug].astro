---
import Base from "../../layouts/Base.astro";
import PublicationList from "../../components/PublicationList.astro";
import { allPublications } from "../../lib/repo";
import { filterByTerm, findTerm, termPath } from "../../lib/taxonomy";

const term = findTerm("region", Astro.params.slug ?? "");
if (!term) {
  return Astro.rewrite("/404");
}
const loaded = await allPublications();
if (loaded instanceof Response) {
  return loaded;
}
const rows = filterByTerm(loaded, term);
---

<Base title={`${term.labelKo} | Compute Current`} description={`${term.label} — Compute Current 발행 목록`} canonicalPath={termPath(term)} noindex={rows.length === 0}>
  <h1>{term.labelKo}{term.labelKo !== term.label && <span class="muted"> · {term.label}</span>}</h1>
  <PublicationList rows={rows} />
</Base>
