---
// Rendered for paths no route matches. The middleware still sees status 404 and turns
// legacy URLs into 301/410 first, so this page shows only for addresses that never existed.
import Base from "../layouts/Base.astro";
import CategoryChips from "../components/CategoryChips.astro";
---

<Base title="Page not found | Compute Current" noindex>
  <header class="page-head">
    <div class="kicker">404</div>
    <h1>Page not found</h1>
    <p>There is nothing at this address. Try the <a href="/" style="color:var(--accent)">home page</a>, the <a href="/archive/" style="color:var(--accent)">archive</a>, or a topic below.</p>
  </header>
  <div style="margin-top:20px"><CategoryChips /></div>
</Base>
