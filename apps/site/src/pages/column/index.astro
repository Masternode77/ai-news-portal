---
import Base from "../../layouts/Base.astro";
import CardGrid from "../../components/CardGrid.astro";
import PublicationList from "../../components/PublicationList.astro";
import { allPublications } from "../../lib/repo";
import { isColumn } from "../../lib/listing";

const loaded = await allPublications();
if (loaded instanceof Response) {
  return loaded;
}
const rows = loaded.filter(isColumn);
---

<Base
  title="The Current | Compute Current"
  description="The Current: Josh Jiwoon Inn's column on the constraints behind AI infrastructure."
  canonicalPath="/column/"
  noindex={rows.length === 0}
  current="/column/"
>
  <header class="page-head">
    <div class="kicker">Column</div>
    <h1>The Current</h1>
    <p>Columns by <a href="/author/josh-inn/" style="color:var(--accent)">Josh Jiwoon Inn</a>, Compute Current's founder and editor: where the real constraints in AI infrastructure sit, who pays for them, and what to watch next.</p>
  </header>
  <div class="section">
    {rows.length === 0 ? <PublicationList rows={rows} empty="No columns have been published yet." /> : <CardGrid rows={rows} level={2} />}
  </div>
</Base>
