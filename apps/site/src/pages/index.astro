---
import Base from "../layouts/Base.astro";
import PublicationList from "../components/PublicationList.astro";
import { allPublications } from "../lib/repo";

const loaded = await allPublications();
if (loaded instanceof Response) {
  return loaded;
}
const rows = loaded.slice(0, 20);
---

<Base title="Compute Current — AI 인프라 인텔리전스" canonicalPath="/">
  <h1>최근 발행</h1>
  <PublicationList rows={rows} empty="아직 발행된 글이 없습니다. 파이프라인이 첫 발행을 마치면 이곳에 표시됩니다." />
  {loaded.length > rows.length && <p><a href="/archive/">전체 아카이브 →</a></p>}
</Base>
