---
import MetaLine from "./MetaLine.astro";
import { publicationPath } from "../lib/listing";
import { contentLang, displayImage, excerpt, primaryCategory } from "../lib/view";
import type { PublicationRow } from "../lib/render";

interface Props {
  rows: PublicationRow[];
  empty?: string;
}

const { rows, empty = "Nothing has been published in this list yet." } = Astro.props;
---

{
  rows.length === 0 ? (
    <p class="empty" data-empty-state>
      {empty}
    </p>
  ) : (
    <ul class="rows">
      {rows.map((row) => {
        const image = displayImage(row);
        const summary = excerpt(row, 180);
        const lang = contentLang(row);
        return (
          <li>
            <a class={image ? "has-thumb" : undefined} href={publicationPath(row)} data-cat={primaryCategory(row)?.slug}>
              {image && (
                <div class="thumb">
                  <img src={image.path} alt={image.alt} width="400" height="225" loading="lazy" decoding="async" />
                </div>
              )}
              <div>
                <MetaLine row={row} />
                <h3 lang={lang}>{row.title}</h3>
                {summary && <p lang={lang}>{summary}</p>}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )
}
