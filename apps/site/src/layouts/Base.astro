---
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteIndexable } from "../lib/repo";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Root-relative canonical path; defaults to the request path. */
  canonicalPath?: string;
  /** Root-relative image for Open Graph; only real artwork, never the placeholder. */
  image?: string | null;
  /** "article" for publication pages. */
  type?: "website" | "article";
  /** Header nav item to mark as current. */
  current?: string;
}

const {
  title,
  description = "Compute Current: AI infrastructure intelligence on power, data centers, chips, cooling and capital.",
  noindex = false,
  canonicalPath,
  image = null,
  type = "website",
  current,
} = Astro.props;
const robots = noindex || !siteIndexable() ? "noindex, nofollow" : "index, follow";
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).toString() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Compute Current RSS" href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="Compute Current" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
