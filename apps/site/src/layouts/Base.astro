---
import { siteIndexable } from "../lib/repo";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Compute Current — AI 인프라 인텔리전스", noindex = false } = Astro.props;
const robots = noindex || !siteIndexable() ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <style>
      :root {
        color-scheme: light dark;
        --fg: #1b1f24;
        --bg: #ffffff;
        --muted: #5b6470;
        --accent: #0b5fff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e8ecf1;
          --bg: #0f1419;
          --muted: #9aa5b1;
          --accent: #7aa7ff;
        }
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans KR", sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.6;
      }
      header,
      main,
      footer {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 16px;
      }
      header {
        padding-top: 24px;
        padding-bottom: 8px;
        border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      }
      header a {
        color: inherit;
        text-decoration: none;
        font-weight: 700;
      }
      main {
        padding-top: 24px;
        padding-bottom: 48px;
      }
      footer {
        color: var(--muted);
        font-size: 0.875rem;
        padding-bottom: 32px;
      }
      a {
        color: var(--accent);
      }
      .muted {
        color: var(--muted);
      }
      img {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">Compute Current</a>
      <span class="muted"> · AI infrastructure intelligence</span>
    </header>
    <main>
      <slot />
    </main>
    <footer>Compute Current rebuild skeleton (Phase 2). Content is served from the publications store only.</footer>
  </body>
</html>
