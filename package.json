{
  "name": "compute-current",
  "type": "module",
  "version": "0.0.73",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "v2:pipeline": "node packages/pipeline/bin/pipeline.ts",
    "v2:typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/pipeline/tsconfig.json && npm run check -w apps/site",
    "v2:test": "node --test \"packages/shared/test/**/*.test.ts\" \"packages/pipeline/test/**/*.test.ts\" \"apps/site/test/**/*.test.ts\"",
    "v2:build": "npm run build -w apps/site"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
